<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Grading System (Control Structures + Validation)</title>

  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f6f7fb;
      margin: 0;
      padding: 28px;
      color: #111827;
    }
    .wrap {
      max-width: 720px;
      margin: 0 auto;
    }
    .card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 18px;
      box-shadow: 0 10px 24px rgba(0,0,0,0.04);
    }
    h1 { margin: 0 0 12px; font-size: 20px; }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 10px;
    }
    label {
      display: block;
      font-size: 13px;
      margin: 8px 0 6px;
      color: #374151;
    }
    input, select {
      width: 100%;
      padding: 10px;
      border-radius: 10px;
      border: 1px solid #d1d5db;
      outline: none;
      box-sizing: border-box;
      background: #fff;
    }
    input:focus, select:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
    }
    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 14px;
      align-items: center;
    }
    button {
      padding: 11px 14px;
      border: 0;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 800;
      background: #2563eb;
      color: #fff;
      flex: 1;
      min-width: 180px;
    }
    button.secondary {
      background: #111827;
    }
    button:hover { filter: brightness(0.95); }
    .msg {
      margin-top: 14px;
      padding: 14px;
      border-radius: 12px;
      border: 1px dashed #d1d5db;
      background: #fafafa;
      white-space: pre-wrap;
      min-height: 90px;
    }
    .error {
      color: #b91c1c;
      font-weight: 700;
    }
    .ok {
      color: #0f766e;
      font-weight: 800;
    }
    .small {
      font-size: 12px;
      color: #6b7280;
      margin-top: 10px;
      line-height: 1.4;
    }
    @media (max-width: 600px) {
      .grid { grid-template-columns: 1fr; }
      button { min-width: 100%; }
    }
  </style>
</head>

<body>
  <div class="wrap">
    <div class="card">
      <h1>Grading System</h1>

      <div class="grid">
        <div>
          <label for="marks">Enter Marks (0 - 100)</label>
          <input id="marks" type="number" inputmode="numeric" placeholder="e.g., 78" />
          <div class="small">Validation checks for empty, non-numeric, and range (0–100).</div>
        </div>

        <div>
          <label for="scheme">Grading Scheme</label>
          <select id="scheme">
            <option value="default">A/B/C/D/F (Standard)</option>
            <option value="plusminus">Plus/Minus (A+, A, B+, ...)</option>
          </select>
          <div class="small">Uses control structures (if/else and switch).</div>
        </div>
      </div>

      <div class="actions">
        <button id="gradeBtn" type="button">Get Grade</button>
        <button class="secondary" id="resetBtn" type="button">Reset</button>
      </div>

      <div class="msg" id="output">Type marks and click “Get Grade”.</div>

      <div class="small">
        Default scheme:
        90–100 A, 80–89 B, 70–79 C, 60–69 D, 0–59 F.
      </div>
    </div>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);

    function setOutput(text, type = "info") {
      const out = $("output");
      out.textContent = text;

      out.classList.remove("error", "ok");
      if (type === "error") out.classList.add("error");
      if (type === "ok") out.classList.add("ok");
    }

    function getDefaultGrade(m) {
      if (m >= 90) return "A";
      else if (m >= 80) return "B";
      else if (m >= 70) return "C";
      else if (m >= 60) return "D";
      else return "F";
    }

    function getPlusMinusGrade(m) {
      // A+ : 97–100, A : 93–96, A- : 90–92
      if (m >= 97) return "A+";
      else if (m >= 93) return "A";
      else if (m >= 90) return "A-";
      else if (m >= 87) return "B+";
      else if (m >= 83) return "B";
      else if (m >= 80) return "B-";
      else if (m >= 77) return "C+";
      else if (m >= 73) return "C";
      else if (m >= 70) return "C-";
      else if (m >= 67) return "D+";
      else if (m >= 63) return "D";
      else if (m >= 60) return "D-";
      else return "F";
    }

    function validateMarks(raw) {
      const trimmed = String(raw ?? "").trim();

      if (trimmed === "") {
        return { ok: false, msg: "Marks cannot be empty." };
      }

      const n = Number(trimmed);
      if (!Number.isFinite(n)) {
        return { ok: false, msg: "Marks must be a valid number." };
      }

      if (n < 0 || n > 100) {
        return { ok: false, msg: "Marks must be between 0 and 100." };
      }

      return { ok: true, value: n };
    }

    $("gradeBtn").addEventListener("click", () => {
      const rawMarks = $("marks").value;
      const scheme = $("scheme").value;

      const check = validateMarks(rawMarks);
      if (!check.ok) {
        console.error("Validation error:", check.msg);
        setOutput(check.msg, "error");
        return;
      }

      const marks = check.value;

      // control structure demo: switch
      let grade;
      switch (scheme) {
        case "plusminus":
          grade = getPlusMinusGrade(marks);
          break;
        case "default":
        default:
          grade = getDefaultGrade(marks);
          break;
      }

      // extra control structure demo: if/else based on grade
      let remark;
      if (grade === "A" || grade === "A+" ) {
        remark = "Excellent performance.";
      } else if (grade.startsWith("B")) {
        remark = "Very good performance.";
      } else if (grade.startsWith("C")) {
        remark = "Good, keep improving.";
      } else if (grade.startsWith("D")) {
        remark = "Passing, but needs improvement.";
      } else {
        remark = "Needs significant improvement.";
      }

      const message = `Marks: ${marks}\nGrade: ${grade}\nRemark: ${remark}`;
      console.log("Grading result:", { marks, scheme, grade });
      setOutput(message, "ok");
    });

    $("resetBtn").addEventListener("click", () => {
      $("marks").value = "";
      $("scheme").value = "default";
      setOutput("Type marks and click “Get Grade”.");
      $("marks").focus();
    });

    $("marks").addEventListener("keydown", (e) => {
      if (e.key === "Enter") $("gradeBtn").click();
    });
  </script>
</body>
</html>
